{
  "release_repo": "Joshspeakman/survival-horror-classics-macos",
  "bundle_id": "io.github.joshspeakman.survival-horror-classics",
  "tag_lowercase": true,
  "cc_args": [
    "-fPIC",
    "-DRT_HOST_RC_INIT=UINT32_MAX"
  ],
  "rt_opt": "-O1",
  "frameworks": [
    "AppKit",
    "GameController",
    "Metal",
    "QuartzCore",
    "CoreText",
    "CoreGraphics",
    "CoreFoundation",
    "AudioToolbox",
    "AVFoundation",
    "CoreMedia",
    "CoreImage"
  ],
  "style": "stone",
  "libs": [],
  "local_network": "The games don't use your local network.",
  "name": "Resident Evil",
  "folder": "Resident Evil",
  "binary": "ResidentEvil",
  "icon_label": "RE1",
  "version": "GOG",
  "where": "Your Resident Evil folder from GOG (installed, or copied from a PC)",
  "minutes": 4,
  "space_gb": 2,
  "build_gb": 1,
  "exe": "ResidentEvil.exe",
  "exe_sha256": {
    "205bd6fed6e080a38823958e5c3306cacc86a18ff9a2758179e8d33caeee4a78": "GOG"
  },
  "required": [
    "USA"
  ],
  "lift_args": [
