  "build": "./build_re.sh re1 \"$GAME\"",
  "out": "work/re1",
  "rt_cflags": [
    "-DRE1_EDITION"
  ],
  "host_cflags": [
    "-DRE1_EDITION"
  ],
  "title": "RESIDENT EVIL",
  "prepare": [
    [
      "convert_movies.py",
      "{game}"
    ]
  ],
  "prepare_text": "Converting the movies",
  "observed_targets": [
    4675420,
    4675452,
    4675484,
    4675496
  ]
}
