{
  "release_repo": "Joshspeakman/survival-horror-classics-macos",
  "bundle_id": "io.github.joshspeakman.survival-horror-classics",
  "tag_lowercase": true,
  "cc_args": [
    "-fPIC",
    "-DRT_HOST_RC_INIT=UINT32_MAX"
  ],
  "rt_opt": "-O1",
  "frameworks": [
    "AppKit",
    "GameController",
    "Metal",
    "QuartzCore",
    "CoreText",
    "CoreGraphics",
    "CoreFoundation",
    "AudioToolbox",
    "AVFoundation",
    "CoreMedia",
    "CoreImage"
  ],
  "style": "stone",
  "libs": [],
  "local_network": "The games don't use your local network.",
  "name": "Resident Evil 3",
  "folder": "Resident Evil 3",
  "binary": "ResidentEvil3",
  "icon_label": "RE3",
  "version": "GOG",
  "where": "Your Resident Evil 3 folder from GOG (installed, or copied from a PC)",
  "minutes": 4,
  "space_gb": 2,
  "build_gb": 1,
  "exe": "ResidentEvil3.exe",
  "exe_sha256": {
    "f6ab367f757e6ee76695bc0d3e26957fb4e0a72a6e29f69cb3bc90efd35123ec": "GOG"
  },
  "required": [
    "Rofs1.dat",
    "zmovie"
  ],
  "lift_args": [
    "--game",
    "re3"
  ],
  "art": [
    "shc_art.py",
    "{game}",
    "{art}",
    "re3",
    "--store"
  ],
  "log": "ResidentEvil3",
  "build": "./build_re.sh re3 \"$GAME\"",
  "out": "work/re3",
  "rt_cflags": [
    "-DRE3_EDITION"
  ],
  "host_cflags": [
    "-DRE3_EDITION"
  ],
  "title": "RESIDENT EVIL 3"
}
